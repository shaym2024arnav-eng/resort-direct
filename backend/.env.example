# Copy to .env and fill in. Never commit .env.
PORT=5000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/resort
# Used only by `npm test` (a separate database the tests wipe and re-create)
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/resort_test
JWT_SECRET=replace-with-a-long-random-string
# Optional. Without it, enquiries are sorted by the rule-based fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional. Only if the frontend is served from a different origin.
CLIENT_ORIGIN=
