{
  "name": "resort-direct-backend",
  "version": "1.0.0",
  "description": "Kaapi Hills direct booking API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
